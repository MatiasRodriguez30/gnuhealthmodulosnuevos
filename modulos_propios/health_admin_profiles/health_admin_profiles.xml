<?xml version="1.0"?>
<tryton>
    <data>
        <record model="ir.ui.view" id="admin_profile_view_form">
            <field name="model">gnuhealth.admin.profile</field>
            <field name="type">form</field>
            <field name="name">admin_profile_form</field>
        </record>
        <record model="ir.ui.view" id="admin_profile_view_tree">
            <field name="model">gnuhealth.admin.profile</field>
            <field name="type">tree</field>
            <field name="name">admin_profile_tree</field>
        </record>
        <record model="ir.ui.view" id="admin_profile_log_view_form">
            <field name="model">gnuhealth.admin.profile.log</field>
            <field name="type">form</field>
            <field name="name">admin_profile_log_form</field>
        </record>
        <record model="ir.ui.view" id="admin_profile_log_view_tree">
            <field name="model">gnuhealth.admin.profile.log</field>
            <field name="type">tree</field>
            <field name="name">admin_profile_log_tree</field>
        </record>
        <record model="ir.ui.view" id="admin_profile_apply_start_view">
            <field name="model">gnuhealth.admin.profile.apply.start</field>
            <field name="type">form</field>
            <field name="name">admin_profile_apply_form</field>
        </record>
        <record model="ir.ui.view" id="user_view_form_admin_profile">
            <field name="model">res.user</field>
            <field name="inherit" ref="res.user_view_form"/>
            <field name="name">user_form</field>
        </record>

        <record model="ir.action.act_window" id="act_admin_profile">
            <field name="name">Perfiles de puesto</field>
            <field name="res_model">gnuhealth.admin.profile</field>
        </record>
        <record model="ir.action.act_window.view" id="act_admin_profile_list_view">
            <field name="sequence" eval="10"/>
            <field name="view" ref="admin_profile_view_tree"/>
            <field name="act_window" ref="act_admin_profile"/>
        </record>
        <record model="ir.action.act_window.view" id="act_admin_profile_form_view">
            <field name="sequence" eval="20"/>
            <field name="view" ref="admin_profile_view_form"/>
            <field name="act_window" ref="act_admin_profile"/>
        </record>

        <record model="ir.action.act_window" id="act_admin_profile_log">
            <field name="name">Historial de perfiles</field>
            <field name="res_model">gnuhealth.admin.profile.log</field>
        </record>
        <record model="ir.action.act_window.view" id="act_admin_profile_log_list_view">
            <field name="sequence" eval="10"/>
            <field name="view" ref="admin_profile_log_view_tree"/>
            <field name="act_window" ref="act_admin_profile_log"/>
        </record>
        <record model="ir.action.act_window.view" id="act_admin_profile_log_form_view">
            <field name="sequence" eval="20"/>
            <field name="view" ref="admin_profile_log_view_form"/>
            <field name="act_window" ref="act_admin_profile_log"/>
        </record>

        <record model="ir.action.wizard" id="act_admin_profile_apply">
            <field name="name">Aplicar perfil a usuarios</field>
            <field name="wiz_name">gnuhealth.admin.profile.apply</field>
            <field name="model">gnuhealth.admin.profile</field>
        </record>

        <menuitem name="Perfiles de puesto" id="menu_admin_profile"
            parent="health.gnuhealth_conf_menu" action="act_admin_profile" sequence="90"/>
        <menuitem name="Historial de perfiles" id="menu_admin_profile_log"
            parent="health.gnuhealth_conf_menu" action="act_admin_profile_log" sequence="91"/>
    </data>
</tryton>
